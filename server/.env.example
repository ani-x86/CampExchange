# ── Core ──────────────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/camp_exchange?schema=public
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/camp_exchange_shadow?schema=public
JWT_SECRET=
COLLEGE_EMAIL_DOMAIN=yourcollege.edu.in
NLP_URL=http://localhost:8001
UPLOAD_DIR=./uploads
MAX_IMAGE_MB=5
NODE_ENV=development

# ── Cloudinary (optional – falls back to local /uploads) ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Resend email (optional – disables email features if missing) ───────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Cloudflare Turnstile (optional – skipped in dev if missing) ────────────────
TURNSTILE_SECRET_KEY=

# ── Gemini NLP enhancer (optional – falls back to rule-based pipeline) ─────────
GEMINI_API_KEY=
